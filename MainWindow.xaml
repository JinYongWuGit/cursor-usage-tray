<Window x:Class="CursorUsageTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cursor usage"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Closing="OnClosing">
  <Window.Resources>
    <Style x:Key="CompactViewStyle" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="Visible" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ExpandedViewStyle" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Border Background="#CC13161C" BorderBrush="#3A4050" BorderThickness="1" CornerRadius="10" MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown">
    <Border.Effect>
      <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.45" />
    </Border.Effect>
    <Grid>
      <!-- Compact View -->
      <Border Style="{StaticResource CompactViewStyle}" Padding="14,8">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding SummaryText}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ExpandArrowText}" FontSize="11" Foreground="#94A3B8" Margin="12,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="{Binding ExpandToolTip}" MouseLeftButtonDown="OnToggleExpand" />
          <TextBlock Text="✕" FontSize="12" Foreground="#94A3B8" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Close" MouseLeftButtonDown="OnCloseMouseLeftButtonDown" />
        </StackPanel>
      </Border>

      <!-- Expanded Detailed View -->
      <Border Style="{StaticResource ExpandedViewStyle}" Width="350" Padding="16,14">
        <StackPanel Orientation="Vertical">
          <!-- Header: Pulse Waveform, Cursor Usage, Expand Arrow, Close -->
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path Data="M 1,8 L 4,8 L 7,2 L 10,13 L 13,5 L 16,8 L 19,8" Stroke="#38BDF8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Width="20" Height="15" Margin="0,0,8,0" />
              <TextBlock Text="Cursor Usage" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding ExpandArrowText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Cursor="Hand" ToolTip="{Binding ExpandToolTip}" MouseLeftButtonDown="OnToggleExpand" />
              <TextBlock Text="✕" FontSize="12" Foreground="#94A3B8" Margin="12,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Close" MouseLeftButtonDown="OnCloseMouseLeftButtonDown" />
            </StackPanel>
          </Grid>

          <!-- Top Summary: 2 Columns -->
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <!-- Left: On-demand spend -->
            <StackPanel Grid.Column="0">
              <TextBlock Text="On-demand spend" FontSize="11" Foreground="#94A3B8" />
              <TextBlock Text="{Binding OnDemandSpendText}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,4,0,6" />
              <Border Background="#252A36" CornerRadius="3" Height="6" Width="120" HorizontalAlignment="Left">
                <Border Background="#52525B" CornerRadius="3" Height="6" HorizontalAlignment="Left" Width="{Binding OnDemandBarWidth}" />
              </Border>
            </StackPanel>

            <!-- Right: Monthly usage -->
            <StackPanel Grid.Column="2">
              <TextBlock Text="{Binding MonthlyUsageLabel}" FontSize="11" Foreground="#94A3B8" />
              <TextBlock Text="{Binding MonthlyUsageValue}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,4,0,2" />
              <TextBlock Text="{Binding MonthlyUsageSubtitle}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>

          <!-- Divider -->
          <Border Height="1" Background="#232733" Margin="0,0,0,12" />

          <!-- Usage by Model Heading -->
          <Grid Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Usage by Model" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" />
              <TextBlock Text=" (Current Billing Cycle)" FontSize="12" FontStyle="Italic" Foreground="#94A3B8" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>

          <!-- Model Table Headers -->
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.2*" />
              <ColumnDefinition Width="0.9*" />
              <ColumnDefinition Width="0.9*" />
              <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Model" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" />
            <TextBlock Grid.Column="1" Text="Requests" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" TextAlignment="Right" />
            <TextBlock Grid.Column="2" Text="Tokens" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" TextAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Spend" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" TextAlignment="Right" />
          </Grid>

          <!-- Model Items list -->
          <ItemsControl ItemsSource="{Binding Models}" Margin="0,0,0,6">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="0.9*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Model}" FontSize="12" Foreground="#E4E4E7" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Requests}" FontSize="12" Foreground="#E4E4E7" TextAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="{Binding TokensFormatted}" FontSize="12" Foreground="#E4E4E7" TextAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="{Binding SpendFormatted}" FontSize="12" Foreground="#E4E4E7" TextAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Divider -->
          <Border Height="1" Background="#232733" Margin="0,6,0,10" />

          <!-- Reset date info -->
          <TextBlock Text="{Binding ResetInfoText}" FontSize="11" FontStyle="Italic" Foreground="#94A3B8" Margin="0,0,0,8" />

          <!-- Dashboard Links -->
          <DockPanel Margin="0,2,0,2" LastChildFill="False">
            <TextBlock Cursor="Hand" ToolTip="https://cursor.com/dashboard/usage" MouseLeftButtonDown="OnDashboardLinkClick" DockPanel.Dock="Left">
              <Underline><Run Text="Cursor Usage" Foreground="#38BDF8" FontSize="12" /></Underline>
            </TextBlock>
            <TextBlock Cursor="Hand" ToolTip="Open Cursor Usage &amp; CursorBench Dashboard" MouseLeftButtonDown="OnOpenDashboardWindowClick" DockPanel.Dock="Right">
              <Underline><Run Text="Full Dashboard ↗" Foreground="#A78BFA" FontSize="12" /></Underline>
            </TextBlock>
          </DockPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
